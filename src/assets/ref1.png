<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Learner Performance Dashboard</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f5f7fb;
    color:#1f2937;
}

/* ================= NAVBAR ================= */

.navbar{
    height:65px;
    background:white;
    border-bottom:1px solid #e5e7eb;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 5%;
}

.logo{
    font-size:21px;
    font-weight:bold;
}

.logo span{
    color:#2563eb;
}

.admin{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:14px;
}

.avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#2563eb;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}


/* ================= CONTAINER ================= */

.container{
    width:92%;
    max-width:1250px;
    margin:30px auto;
}


/* ================= HEADER ================= */

.page-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.page-header h1{
    font-size:28px;
    margin-bottom:7px;
}

.page-header p{
    color:#6b7280;
}


/* ================= SEARCH ================= */

.search-box{
    display:flex;
    gap:10px;
}

.search-box input{
    padding:11px 14px;
    border:1px solid #d1d5db;
    border-radius:8px;
    outline:none;
    width:230px;
}

.search-box button{
    border:none;
    background:#2563eb;
    color:white;
    padding:11px 17px;
    border-radius:8px;
    cursor:pointer;
}


/* ================= USER PROFILE ================= */

.profile-card{
    background:white;
    border-radius:15px;
    padding:22px;
    display:flex;
    align-items:center;
    gap:20px;
    box-shadow:0 4px 15px rgba(0,0,0,.05);
    margin-bottom:22px;
}

.profile-avatar{
    width:70px;
    height:70px;
    border-radius:50%;
    background:#e0e7ff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:25px;
    font-weight:bold;
    color:#2563eb;
}

.profile-info h2{
    margin-bottom:5px;
}

.profile-info p{
    color:#6b7280;
    font-size:14px;
    margin:3px 0;
}


/* ================= STAT CARDS ================= */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-bottom:22px;
}

.stat-card{
    background:white;
    padding:20px;
    border-radius:13px;
    box-shadow:0 4px 15px rgba(0,0,0,.05);
}

.stat-title{
    color:#6b7280;
    font-size:14px;
}

.stat-value{
    font-size:28px;
    font-weight:bold;
    margin-top:10px;
}

.stat-sub{
    font-size:13px;
    color:#16a34a;
    margin-top:5px;
}


/* ================= GRID ================= */

.dashboard-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.card{
    background:white;
    padding:22px;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,.05);
}

.card h2{
    font-size:19px;
    margin-bottom:18px;
}


/* ================= ATTENDANCE ================= */

.attendance{
    display:flex;
    align-items:center;
    gap:25px;
}

.circle{
    width:120px;
    height:120px;
    border-radius:50%;
    background:
        conic-gradient(
            #2563eb 0deg 331deg,
            #e5e7eb 331deg 360deg
        );
    display:flex;
    align-items:center;
    justify-content:center;
}

.circle-inner{
    width:88px;
    height:88px;
    background:white;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    font-weight:bold;
}

.attendance-info p{
    margin:9px 0;
    color:#6b7280;
}


/* ================= PROGRESS ================= */

.progress-item{
    margin-bottom:18px;
}

.progress-top{
    display:flex;
    justify-content:space-between;
    font-size:14px;
    margin-bottom:7px;
}

.progress-bar{
    height:9px;
    background:#e5e7eb;
    border-radius:10px;
    overflow:hidden;
}

.progress-fill{
    height:100%;
    background:#2563eb;
    border-radius:10px;
}


/* ================= SKILLS ================= */

.skill{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 0;
    border-bottom:1px solid #f0f0f0;
}

.skill:last-child{
    border-bottom:none;
}

.skill-name{
    font-size:14px;
}

.badge{
    padding:5px 9px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
}

.strong{
    background:#dcfce7;
    color:#15803d;
}

.medium{
    background:#fef3c7;
    color:#a16207;
}

.weak{
    background:#fee2e2;
    color:#dc2626;
}


/* ================= ATTENTION ================= */

.attention-box{
    display:flex;
    align-items:center;
    gap:20px;
}

.attention-number{
    font-size:40px;
    font-weight:bold;
}

.attention-text{
    color:#6b7280;
}

.attention-status{
    margin-top:8px;
    color:#16a34a;
    font-weight:bold;
}


/* ================= PENDING ================= */

.pending-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:13px 0;
    border-bottom:1px solid #f0f0f0;
}

.pending-item:last-child{
    border-bottom:none;
}

.pending-name{
    font-size:14px;
}

.due{
    color:#dc2626;
    font-size:12px;
}


/* ================= STRENGTH / WEAKNESS ================= */

.insight{
    padding:15px;
    border-radius:10px;
    margin-bottom:12px;
}

.insight h3{
    font-size:15px;
    margin-bottom:5px;
}

.insight p{
    font-size:13px;
    color:#6b7280;
}

.strength{
    background:#f0fdf4;
}

.weakness{
    background:#fff7ed;
}


/* ================= MCQ ================= */

.accuracy{
    display:flex;
    align-items:center;
    gap:25px;
}

.accuracy-score{
    font-size:42px;
    font-weight:bold;
}

.accuracy-text{
    color:#6b7280;
}


/* ================= RESPONSIVE ================= */

@media(max-width:900px){

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .dashboard-grid{
        grid-template-columns:1fr;
    }

}

@media(max-width:600px){

    .page-header{
        flex-direction:column;
        align-items:flex-start;
        gap:15px;
    }

    .search-box{
        width:100%;
    }

    .search-box input{
        width:100%;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .profile-card{
        align-items:flex-start;
    }

}

</style>
</head>


<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar">

    <div class="logo">
        Skill<span>Intelligence</span>
    </div>

    <div class="admin">

        <span>Official / Supervisor</span>

        <div class="avatar">
            O
        </div>

    </div>

</nav>



<div class="container">


<!-- ================= HEADER ================= -->

<div class="page-header">

    <div>

        <h1>Learner Performance Dashboard</h1>

        <p>
            Monitor learning progress, competency development and pending activities.
        </p>

    </div>


    <div class="search-box">

        <input
            type="text"
            id="searchInput"
            placeholder="Search learner..."
        >

        <button onclick="searchLearner()">
            Search
        </button>

    </div>

</div>



<!-- ================= PROFILE ================= -->

<div class="profile-card">

    <div class="profile-avatar">
        RS
    </div>

    <div class="profile-info">

        <h2 id="learnerName">
            Rahul Sharma
        </h2>

        <p>
            Employee ID: STAT-1042
        </p>

        <p>
            Statistical Officer • Official Statistics Division
        </p>

        <p>
            Last active: Today, 10:42 AM
        </p>

    </div>

</div>



<!-- ================= STATISTICS ================= -->

<div class="stats">


    <div class="stat-card">

        <div class="stat-title">
            Attendance
        </div>

        <div class="stat-value">
            92%
        </div>

        <div class="stat-sub">
            +4% this month
        </div>

    </div>


    <div class="stat-card">

        <div class="stat-title">
            MCQ Accuracy
        </div>

        <div class="stat-value">
            86%
        </div>

        <div class="stat-sub">
            +8% improvement
        </div>

    </div>


    <div class="stat-card">

        <div class="stat-title">
            Skills Covered
        </div>

        <div class="stat-value">
            18
        </div>

        <div class="stat-sub">
            4 in progress
        </div>

    </div>


    <div class="stat-card">

        <div class="stat-title">
            Pending Tasks
        </div>

        <div class="stat-value">
            5
        </div>

        <div class="stat-sub" style="color:#dc2626;">
            2 overdue
        </div>

    </div>

</div>



<!-- ================= DASHBOARD GRID ================= -->

<div class="dashboard-grid">


<!-- ================= ATTENDANCE ================= -->

<div class="card">

    <h2>Attendance</h2>

    <div class="attendance">

        <div class="circle">

            <div class="circle-inner">
                92%
            </div>

        </div>


        <div class="attendance-info">

            <p>
                Present: <strong>46 days</strong>
            </p>

            <p>
                Absent: <strong>4 days</strong>
            </p>

            <p>
                Learning sessions: <strong>38</strong>
            </p>

        </div>

    </div>

</div>



<!-- ================= ATTENTION SPAN ================= -->

<div class="card">

    <h2>Attention Span</h2>

    <div class="attention-box">

        <div class="attention-number">
            74%
        </div>

        <div>

            <div class="attention-text">
                Average focused learning time
            </div>

            <div class="attention-status">
                Good engagement
            </div>

        </div>

    </div>

    <br>

    <div class="progress-bar">

        <div
            class="progress-fill"
            style="width:74%;">
        </div>

    </div>

</div>



<!-- ================= MCQ ACCURACY ================= -->

<div class="card">

    <h2>MCQ Performance</h2>

    <div class="accuracy">

        <div class="accuracy-score">
            86%
        </div>

        <div class="accuracy-text">

            <p>
                172 correct answers
            </p>

            <p>
                28 incorrect answers
            </p>

            <p>
                200 questions attempted
            </p>

        </div>

    </div>

</div>



<!-- ================= SKILLS COVERED ================= -->

<div class="card">

    <h2>Skills Covered</h2>


    <div class="progress-item">

        <div class="progress-top">

            <span>Statistical Analysis</span>

            <span>90%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:90%;">
            </div>

        </div>

    </div>


    <div class="progress-item">

        <div class="progress-top">

            <span>SQL</span>

            <span>82%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:82%;">
            </div>

        </div>

    </div>


    <div class="progress-item">

        <div class="progress-top">

            <span>Python</span>

            <span>65%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:65%;">
            </div>

        </div>

    </div>


    <div class="progress-item">

        <div class="progress-top">

            <span>AI / ML</span>

            <span>42%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:42%;">
            </div>

        </div>

    </div>

</div>



<!-- ================= STRENGTHS ================= -->

<div class="card">

    <h2>Strengths</h2>


    <div class="insight strength">

        <h3>Statistical Analysis</h3>

        <p>
            Consistently high assessment performance.
        </p>

    </div>


    <div class="insight strength">

        <h3>SQL & Data Handling</h3>

        <p>
            Strong performance in database-related assessments.
        </p>

    </div>


    <div class="insight strength">

        <h3>Survey Design</h3>

        <p>
            Demonstrates strong understanding of survey methodology.
        </p>

    </div>

</div>



<!-- ================= WEAK AREAS ================= -->

<div class="card">

    <h2>Weaker Sections</h2>


    <div class="skill">

        <span class="skill-name">
            AI / Machine Learning
        </span>

        <span class="badge weak">
            Needs Improvement
        </span>

    </div>


    <div class="skill">

        <span class="skill-name">
            Cloud Computing
        </span>

        <span class="badge weak">
            Beginner
        </span>

    </div>


    <div class="skill">

        <span class="skill-name">
            GIS
        </span>

        <span class="badge medium">
            Developing
        </span>

    </div>


    <div class="skill">

        <span class="skill-name">
            Data Visualization
        </span>

        <span class="badge medium">
            Developing
        </span>

    </div>

</div>



<!-- ================= PENDING ================= -->

<div class="card">

    <h2>Pending Activities</h2>


    <div class="pending-item">

        <span class="pending-name">
            AI Fundamentals Assessment
        </span>

        <span class="due">
            Due today
        </span>

    </div>


    <div class="pending-item">

        <span class="pending-name">
            Python Data Analysis Module
        </span>

        <span class="due">
            2 days
        </span>

    </div>


    <div class="pending-item">

        <span class="pending-name">
            GIS Learning Module
        </span>

        <span class="due">
            4 days
        </span>

    </div>


    <div class="pending-item">

        <span class="pending-name">
            Statistical Quality Assessment
        </span>

        <span class="due">
            5 days
        </span>

    </div>


    <div class="pending-item">

        <span class="pending-name">
            Cloud Computing Quiz
        </span>

        <span class="due">
            7 days
        </span>

    </div>

</div>



<!-- ================= COMPETENCY ================= -->

<div class="card">

    <h2>Competency Overview</h2>


    <div class="progress-item">

        <div class="progress-top">

            <span>Statistical Competencies</span>

            <span>84%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:84%;">
            </div>

        </div>

    </div>


    <div class="progress-item">

        <div class="progress-top">

            <span>Technical Competencies</span>

            <span>67%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:67%;">
            </div>

        </div>

    </div>


    <div class="progress-item">

        <div class="progress-top">

            <span>Digital Governance</span>

            <span>58%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:58%;">
            </div>

        </div>

    </div>


    <div class="progress-item">

        <div class="progress-top">

            <span>Behavioural & Managerial</span>

            <span>76%</span>

        </div>

        <div class="progress-bar">

            <div
                class="progress-fill"
                style="width:76%;">
            </div>

        </div>

    </div>

</div>


</div>


</div>



<script>

/* ================= SEARCH ================= */

function searchLearner(){

    const input =
        document.getElementById("searchInput").value
        .trim();

    if(input === ""){

        alert("Enter a learner name or employee ID.");

        return;

    }

    /*
       DEMO ONLY

       In the actual application this would call:

       GET /api/learners?search=...

       and load the selected learner's
       performance data from the database.
    */

    document.getElementById("learnerName")
        .textContent = input;

}


/* ================= DEMO AUTO UPDATE ================= */

const attention =
    document.querySelector(".attention-number");

let attentionValue = 74;


/*
   Demonstration of live dashboard behaviour.

   In the real system this would receive
   actual learner activity from the backend.
*/

setInterval(() => {

    if(attentionValue < 76){

        attentionValue += 1;

        attention.textContent =
            attentionValue + "%";

    }

}, 5000);

</script>

</body>
</html>